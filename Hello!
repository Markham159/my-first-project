import random


def play_game() -> None:
    """Run a simple terminal number guessing game."""
    target_number = random.randint(1, 20)
    attempts_remaining = 5

    print("🎮 Welcome to Guess Quest!")
    print("I'm thinking of a number between 1 and 20.")
    print(f"You have {attempts_remaining} attempts. Good luck!\n")

    while attempts_remaining > 0:
        guess_raw = input("Enter your guess: ").strip()

        if not guess_raw.isdigit():
            print("Please enter a whole number.\n")
            continue

        guess = int(guess_raw)
        attempts_remaining -= 1

        if guess == target_number:
            print("🏆 You win! You guessed it!")
            return

        if guess < target_number:
            hint = "Too low"
        else:
            hint = "Too high"

        if attempts_remaining > 0:
            print(f"{hint}! Attempts left: {attempts_remaining}\n")

    print(f"💥 Game over! The number was {target_number}.")


if __name__ == "__main__":
    play_game()
